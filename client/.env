# Local development defaults — CACCO Command Platform (poc: cacco)
#
# Frontend-only prototype: all data comes from the static seed in
# src/services/socket.js. No backend needs to be running to develop this app.
#
# Create React App only inlines REACT_APP_-prefixed variables, at build time.
# VITE_* names are ignored by this stack.

REACT_APP_API_URL=http://localhost:4305
REACT_APP_SOCKET_URL=http://localhost:4305
REACT_APP_REALTIME_MODE=polling
