# Production environment variables
# Copy this file to .env.production.local and fill in real values before deploying.
# Never commit .env.production.local to source control.

# URL of the REST API backend (required when a real backend is connected)
REACT_APP_API_URL=https://api.your-domain.com

# URL of the Socket.io server (required for real-time updates)
REACT_APP_SOCKET_URL=https://api.your-domain.com

# Real-time mode: "socket" (Socket.io) or "polling" (HTTP polling fallback)
REACT_APP_REALTIME_MODE=polling
