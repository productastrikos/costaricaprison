# Production environment — CACCO Command Platform (poc: cacco)
#
# This app is a frontend-only prototype: src/services/api.js and
# src/services/socket.js are mock/static-seed stubs, so nothing in src reads
# these variables yet. They are set now so that a future backend on
# cacco-api.astrikos.xyz:8443 (port 4305, reserved) needs no code change here.
#
# NOTE: Create React App only inlines variables prefixed REACT_APP_, and it does
# so at BUILD time. VITE_* names are ignored by this stack — do not use them.
# Changing any value below requires a rebuild, not just a restart.

REACT_APP_API_URL=https://cacco-api.astrikos.xyz:8443
REACT_APP_SOCKET_URL=https://cacco-api.astrikos.xyz:8443

# "socket" (Socket.io) or "polling" (HTTP fallback).
# Keep "polling" until a real backend is live on 4305.
REACT_APP_REALTIME_MODE=polling
